{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulpminer-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mcp.pulpminer.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
